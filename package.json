{
  "name": "shroom-room",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:frontend\" \"npm run dev:server\"",
    "dev:frontend": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/index.js --packages=external",
    "prod:build": "npm run build",
    "prod:start": "node dist/index.js",
    "start": "npm run prod:start"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "geotiff": "^2.1.3",
    "leaflet": "^1.9.4",
    "lucide": "^0.475.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.16",
    "@types/node": "^22.13.4",
    "concurrently": "^9.1.2",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}